# Base URL of the backend API. Leave unset in development — Vite proxies /api to the backend.
# For production builds, point it at your deployed API, e.g. https://api.layerforge.studio/api
# (the GitHub Pages workflow reads it from the repository variable VITE_API_URL).
# VITE_API_URL=

# Where the Vite dev server forwards /api requests (default http://localhost:4000)
# VITE_DEV_API_TARGET=http://localhost:4000
